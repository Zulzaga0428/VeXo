# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VexoAI Studio — Railway Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy these into Railway > Variables tab
# All values are REQUIRED unless marked optional

# ── App URL ────────────────────────────────────────
# Railway-н өгсөн domain-г оруул: https://xxx.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# ── Supabase (Auth) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Fal.ai (Video & Image generation) ─────────────
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxx

# ── Anthropic (Claude AI) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Camb.ai (Mongolian TTS) ───────────────────────
CAMB_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Vercel Blob (File storage) ─────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── QPay (Mongolian payment) ──────────────────────
QPAY_USERNAME=YOUR_QPAY_USERNAME
QPAY_PASSWORD=YOUR_QPAY_PASSWORD
QPAY_INVOICE_CODE=YOUR_INVOICE_CODE

# ── Kling (Video generation — optional) ───────────
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=

# ── Admin ──────────────────────────────────────────
# Admin email-үүд таслалаар тусгаарла
ADMIN_EMAILS=your@email.com

# ── Railway auto-sets this, don't add manually ─────
# PORT=3000
# NODE_ENV=production
